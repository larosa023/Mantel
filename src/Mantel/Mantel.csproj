<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mantel</AssemblyName>
    <RootNamespace>Mantel</RootNamespace>
    <ApplicationIcon>Assets\mantel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Bump this and push to main to ship a release (see .github/workflows/release.yml). -->
    <Version>0.6.0</Version>
    <Product>Mantel</Product>
    <Description>Clean, lightweight desktop widgets for Windows.</Description>
  </PropertyGroup>

  <!-- Footprint: Mantel sits in the background all day, so favor low memory and a fast start. -->
  <PropertyGroup>
    <!-- Workstation GC without the background thread: smaller heaps for a small app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Give memory back to Windows sooner after a spike (e.g. opening Settings). -->
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <TieredPGO>true</TieredPGO>
    <!-- Precompiled code in release builds: starts noticeably faster at login. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <!-- Keep in step with the vpk version in .github/workflows/release.yml -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Mantel design language. Every value here comes from the active theme
       (ThemeManager sets these resources at runtime); these defaults are Glass. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="Mantel.CardBackground" Color="#E0141519" />
    <SolidColorBrush x:Key="Mantel.CardBorder" Color="#22FFFFFF" />
    <Thickness x:Key="Mantel.CardBorderThickness">1</Thickness>
    <CornerRadius x:Key="Mantel.CardRadius">16</CornerRadius>
    <Thickness x:Key="Mantel.CardPadding">18,14</Thickness>
    <BoxShadows x:Key="Mantel.CardShadow">0 6 24 0 #59000000</BoxShadows>
    <SolidColorBrush x:Key="Mantel.Accent" Color="#E8A15A" />
    <SolidColorBrush x:Key="Mantel.AccentSoft" Color="#B3E8A15A" />
    <SolidColorBrush x:Key="Mantel.AccentText" Color="#141519" />
    <SolidColorBrush x:Key="Mantel.Text" Color="#F0ECE4" />
    <SolidColorBrush x:Key="Mantel.TextMuted" Color="#A8A49D" />
    <SolidColorBrush x:Key="Mantel.TextLabel" Color="#8C8A86" />
    <SolidColorBrush x:Key="Mantel.Track" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Mantel.Divider" Color="#1AFFFFFF" />
    <FontWeight x:Key="Mantel.BigWeight">Light</FontWeight>
    <x:Double x:Key="Mantel.BigSize">44</x:Double>
    <SolidColorBrush x:Key="Mantel.FlyoutBackground" Color="#F2141519" />
    <SolidColorBrush x:Key="Mantel.FlyoutBorder" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Mantel.SectionBackground" Color="#0DFFFFFF" />
    <CornerRadius x:Key="Mantel.FlyoutRadius">22</CornerRadius>
    <CornerRadius x:Key="Mantel.SectionRadius">14</CornerRadius>
  </Styles.Resources>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Mantel.CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mantel.CardBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Mantel.CardBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mantel.CardRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Mantel.CardPadding}" />
    <!-- Room for the shadow inside the transparent window. -->
    <Setter Property="Margin" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource Mantel.CardShadow}" />
  </Style>

  <!-- Unlocked: hovering a widget outlines it in the accent to show it can be dragged.
       Only on hover, so an unlocked desktop still looks clean (and Bare stays borderless). -->
  <Style Selector="Border.card.unlocked:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Mantel.AccentSoft}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Widget windows and flyouts carry the "widget" class; this keeps theme text colors out of Settings. -->
  <Style Selector="Window.widget TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>

  <Style Selector="TextBlock.big">
    <Setter Property="FontSize" Value="{DynamicResource Mantel.BigSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource Mantel.BigWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>

  <Style Selector="TextBlock.strong">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>

  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="{DynamicResource Mantel.BigWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.TextLabel}" />
  </Style>

  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Accent}" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.TextMuted}" />
  </Style>

  <Style Selector="Border.track">
    <Setter Property="Background" Value="{DynamicResource Mantel.Track}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Height" Value="6" />
  </Style>

  <Style Selector="Border.fill">
    <Setter Property="Background" Value="{DynamicResource Mantel.Accent}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Height" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.fill.hot">
    <Setter Property="Background" Value="#E8665A" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource Mantel.Divider}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.placeholder">
    <Setter Property="Background" Value="{DynamicResource Mantel.Track}" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource Mantel.Accent}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.AccentText}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>

  <!-- Round, borderless icon buttons (media controls) -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon Path.glyph">
    <Setter Property="Fill" Value="{DynamicResource Mantel.Text}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.Track}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.Divider}" />
  </Style>

  <!-- Big round play button in the large Now Playing layout -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="54" />
    <Setter Property="Height" Value="54" />
    <Setter Property="CornerRadius" Value="27" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Mantel.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.play Path.glyph">
    <Setter Property="Fill" Value="{DynamicResource Mantel.AccentText}" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.AccentSoft}" />
  </Style>

  <!-- App launcher tiles -->
  <Style Selector="Border.launcher-tile">
    <Setter Property="Background" Value="{DynamicResource Mantel.Track}" />
  </Style>
  <Style Selector="Button.row:pointerover Border.launcher-tile">
    <Setter Property="Background" Value="{DynamicResource Mantel.AccentSoft}" />
  </Style>
  <Style Selector="Border.launcher-tile > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Accent}" />
  </Style>

  <!-- Notes: the text box blends into the card -->
  <Style Selector="TextBox.note">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Mantel.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Mantel.AccentSoft}" />
  </Style>
  <Style Selector="TextBox.note:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.note:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.note /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.TextMuted}" />
  </Style>

  <!-- Line icons (UI/Icons.cs) take the surrounding text color unless given one -->
  <Style Selector="Path.icon-stroke">
    <Setter Property="Stroke" Value="{DynamicResource Mantel.Text}" />
  </Style>
  <Style Selector="Path.icon-accent">
    <Setter Property="Stroke" Value="{DynamicResource Mantel.Accent}" />
  </Style>

  <!-- ===================== Flyout panel ===================== -->
  <Style Selector="Border.flyout">
    <Setter Property="Background" Value="{DynamicResource Mantel.FlyoutBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mantel.FlyoutBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mantel.FlyoutRadius}" />
    <Setter Property="BoxShadow" Value="0 12 40 0 #73000000" />
    <Setter Property="Margin" Value="14" />
  </Style>
  <Style Selector="Border.flyout-section">
    <Setter Property="Background" Value="{DynamicResource Mantel.SectionBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mantel.SectionRadius}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- Small text button inside widgets (EQ preset picker) -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource Mantel.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{DynamicResource Mantel.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.AccentText}" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.Divider}" />
  </Style>
  <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.AccentSoft}" />
  </Style>

  <!-- Clickable game rows in the scores widget -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="-6,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.Text}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.Track}" />
  </Style>

  <!-- ===================== Settings window (its own fixed dark look) ===================== -->
  <Style Selector="Window.settings TextBlock">
    <Setter Property="Foreground" Value="#F0ECE4" />
  </Style>
  <Style Selector="Window.settings TextBlock.muted">
    <Setter Property="Foreground" Value="#A3A09A" />
  </Style>
  <Style Selector="Window.settings TextBlock.group">
    <Setter Property="Foreground" Value="#D6D2CA" />
  </Style>
  <Style Selector="Window.settings Path.icon-stroke">
    <Setter Property="Stroke" Value="#E6E2DA" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="#66000000" />
    <Setter Property="BorderBrush" Value="#12FFFFFF" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Button.nav.selected Path.icon-stroke">
    <Setter Property="Stroke" Value="{DynamicResource Mantel.Accent}" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Setting cards: the rows every page is made of -->
  <Style Selector="Border.setting-card">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="#0FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.setting-card.clickable:pointerover">
    <Setter Property="Background" Value="#1CFFFFFF" />
  </Style>
  <Style Selector="Border.setting-card.empty">
    <Setter Property="Background" Value="#0AFFFFFF" />
    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
  </Style>
  <Style Selector="Border.icon-tile">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Window.settings Button">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Mantel.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Mantel.AccentText}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.AccentText}" />
  </Style>
  <Style Selector="Button.primary Path.icon-stroke">
    <Setter Property="Stroke" Value="{DynamicResource Mantel.AccentText}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.AccentSoft}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#26E8665A" />
    <Setter Property="Foreground" Value="#FF9B91" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40E8665A" />
  </Style>

  <!-- Segmented control -->
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.segment.first">
    <Setter Property="CornerRadius" Value="8,0,0,8" />
  </Style>
  <Style Selector="Button.segment.last">
    <Setter Property="CornerRadius" Value="0,8,8,0" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.segment.first.last">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{DynamicResource Mantel.Accent}" />
  </Style>
  <Style Selector="Button.segment.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mantel.AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Mantel.AccentSoft}" />
  </Style>

  <!-- Theme gallery tiles and flyout icon choices -->
  <Style Selector="Button.theme-tile">
    <Setter Property="Background" Value="#0DFFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,10,10,12" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.theme-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#17FFFFFF" />
  </Style>
  <Style Selector="Button.theme-tile.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Mantel.Accent}" />
  </Style>
  <Style Selector="Button.theme-tile.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Mantel.Accent}" />
  </Style>
  <Style Selector="Button.icon-choice">
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon-choice.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Mantel.Accent}" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

</Styles>
